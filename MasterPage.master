<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="MasterPage.master.cs" Inherits="AgricultureManagementSystem.MasterPage" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Agriculture Management System</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link href="~/Content/site.css" runat="server" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">

        <nav class="navbar navbar-expand-lg navbar-dark ag-navbar sticky-top">
            <div class="container-fluid px-4">
                <a class="navbar-brand" href="~/Public/Default.aspx" runat="server">
                    <i class="bi bi-flower1"></i> Agriculture Management System
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Public/Default.aspx">Home</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Public/Products.aspx">Products</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Public/Equipment.aspx">Equipment</a></li>
                        <li class="nav-item"><a class="nav-link" href="<%= ResolveUrl("~/Public/Cart.aspx") %>"><i class="bi bi-cart3"></i> Cart <span class="badge bg-warning text-dark"><%= CartCount %></span></a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Public/Contact.aspx">Contact</a></li>

                        <asp:PlaceHolder ID="phGuestLinks" runat="server">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle"></i> Login
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" runat="server" href="~/Farmer/FarmerLogin.aspx">Farmer Login</a></li>
                                    <li><a class="dropdown-item" runat="server" href="~/Farmer/FarmerRegister.aspx">Farmer Registration</a></li>
                                </ul>
                            </li>
                        </asp:PlaceHolder>

                        <asp:PlaceHolder ID="phFarmerLinks" runat="server" Visible="false">
                            <li class="nav-item"><a class="nav-link" runat="server" href="~/Farmer/FarmerDashboard.aspx"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                            <li class="nav-item">
                                <asp:LinkButton ID="lnkFarmerLogout" runat="server" CssClass="nav-link" OnClick="lnkFarmerLogout_Click">
                                    <i class="bi bi-box-arrow-right"></i> Logout
                                </asp:LinkButton>
                            </li>
                        </asp:PlaceHolder>
                    </ul>
                </div>
            </div>
        </nav>

        <div class="container-fluid">
            <div class="row">

                <asp:PlaceHolder ID="phSidebar" runat="server" Visible="false">
                    <div class="col-lg-2 d-none d-lg-block ag-sidebar p-0">
                        <asp:PlaceHolder ID="phFarmerSidebarLinks" runat="server" Visible="false">
                            <a runat="server" href="~/Farmer/FarmerDashboard.aspx"><i class="bi bi-speedometer2"></i> Dashboard</a>
                            <a runat="server" href="~/Farmer/AddCrop.aspx"><i class="bi bi-plus-circle"></i> Add Crop</a>
                            <a runat="server" href="~/Farmer/ViewCrop.aspx"><i class="bi bi-flower2"></i> My Crops</a>
                            <a runat="server" href="~/Farmer/AddProduct.aspx"><i class="bi bi-plus-square"></i> Add Product</a>
                            <a runat="server" href="~/Farmer/ManageProducts.aspx"><i class="bi bi-basket"></i> My Products</a>
                            <a runat="server" href="~/Farmer/ApplyEquipment.aspx"><i class="bi bi-tools"></i> Apply for Equipment</a>
                        </asp:PlaceHolder>
                    </div>
                </asp:PlaceHolder>

                <div id="mainContentCol" runat="server" class="col-12">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
                </div>
            </div>
        </div>

        <footer class="ag-footer mt-4">
            <div class="container">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <h5 class="text-white"><i class="bi bi-flower1"></i> Agriculture Management System</h5>
                        <p class="small">Connecting farmers, buyers, and resources on one digital platform.</p>
                    </div>
                    <div class="col-md-4 mb-3">
                        <h6 class="text-white">Quick Links</h6>
                        <p class="small mb-1"><a runat="server" href="~/Public/Contact.aspx">Contact</a></p>
                    </div>
                    <div class="col-md-4 mb-3">
                        <h6 class="text-white">Contact Us</h6>
                        <p class="small mb-1"><i class="bi bi-geo-alt"></i> Rajkot, Gujarat, India</p>
                        <p class="small mb-1"><i class="bi bi-envelope"></i> support@agrimanage.rw</p>
                    </div>
                </div>
                <hr style="border-color: rgba(255,255,255,0.2);" />
                <p class="text-center small mb-0">&copy; <%= DateTime.Now.Year %> Agriculture Management System. All rights reserved.</p>
            </div>
        </footer>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

        <script src="<%= ResolveUrl("~/Scripts/validation.js") %>"></script>

        <asp:ContentPlaceHolder ID="ScriptsContent" runat="server"></asp:ContentPlaceHolder>
    </form>
</body>
</html>